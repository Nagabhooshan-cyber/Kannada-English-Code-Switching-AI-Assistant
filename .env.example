# Copy to .env for local use; never commit the real .env file.
HF_TOKEN=
GEMINI_API_KEY=
# Optional; only used for uncertain tokens. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
TRANSLATION_BACKEND=gemini
LOG_LEVEL=INFO
MAX_INPUT_CHARS=2000
